# Same bucket the Python pipeline uses (Cloudflare R2)
S3_BUCKET=cse-data
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Password for the site (anyone with it can see every brand)
SITE_PASSWORD=

# Open in Google Docs (docs/google-docs.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Guests who see one brand only: brand:password, comma-separated
GUEST_PASSWORDS=

# Copy to .env on each machine and fill in. Never commit .env.

# Where brand data lives: "s3" (cloud, use this) or "local" (tests/offline only, does not sync)
STORAGE_BACKEND=s3

# Any S3-compatible bucket. Examples:
#   Cloudflare R2:     https://<account_id>.r2.cloudflarestorage.com   (region: auto)
#   Backblaze B2:      https://s3.<region>.backblazeb2.com
#   Supabase Storage:  https://<project_ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only used when STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data

# Claude API (analysis + summarizing)
ANTHROPIC_API_KEY=

# Copy to .env on each machine and fill in. Never commit .env.

# Where brand data lives: "s3" (cloud, use this) or "local" (tests/offline only, does not sync)
STORAGE_BACKEND=s3

# Any S3-compatible bucket. Examples:
#   Cloudflare R2:     https://<account_id>.r2.cloudflarestorage.com   (region: auto)
#   Backblaze B2:      https://s3.<region>.backblazeb2.com
#   Supabase Storage:  https://<project_ref>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Only used when STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data

# Claude API (analysis + summarizing)
ORE_ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CSE_MODEL=

# Meta ad data (scrapecreators.com)
SCRAPECREATORS_API_KEY=
KALODATA_API_KEY=            # Kalodata API (TikTok Shop sales data) for product research

# Free teardowns (cse/teardown.py, web/lib/teardown.ts). Email is off until both are set.
RESEND_API_KEY=
ORE_MAIL_FROM=Ore <teardown@yourdomain.com>
ORE_SITE_URL=https://ore-web-eight.vercel.app
TEARDOWN_DAILY_CAP=20
TEARDOWN_MONTHLY_CAP=100

# Product photos for slides (Google AI Studio key)
GEMINI_API_KEY=
